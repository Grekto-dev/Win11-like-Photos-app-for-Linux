[Desktop Entry]
Type=Application
Name=Photos
Name[pt_BR]=Fotos
Name[es]=Fotos
Name[fr]=Photos
Name[zh_CN]=照片
Name[hi]=फ़ोटो
Name[ar]=الصور
GenericName=Image viewer
GenericName[pt_BR]=Visualizador de imagens
GenericName[es]=Visor de imágenes
GenericName[fr]=Visionneuse d'images
GenericName[zh_CN]=图像查看器
Comment=View, organize and edit your photos
Comment[pt_BR]=Visualize, organize e edite suas fotos
Comment[es]=Ve, organiza y edita tus fotos
Comment[fr]=Affichez, organisez et modifiez vos photos
Comment[zh_CN]=查看、整理和编辑照片
Exec=fotos %F
Icon=fotos
Terminal=false
Categories=Graphics;Photography;Viewer;GTK;
StartupWMClass=fotos.Fotos
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/webp;image/tiff;image/svg+xml;image/x-icon;image/heif;image/heic;image/avif;image/jxl;image/x-tga;
Keywords=photos;pictures;images;gallery;viewer;fotos;
Actions=Settings;Slideshow;

[Desktop Action Settings]
Name=Settings
Name[pt_BR]=Configurações
Name[es]=Configuración
Name[fr]=Paramètres
Name[zh_CN]=设置
Exec=fotos --settings

[Desktop Action Slideshow]
Name=Slideshow
Name[pt_BR]=Apresentação de slides
Name[es]=Presentación
Name[fr]=Diaporama
Name[zh_CN]=幻灯片放映
